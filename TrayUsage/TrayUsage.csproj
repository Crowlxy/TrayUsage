<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <!-- Memory: skip ICU loading (all formatting uses fixed patterns) and the background GC thread (heap is a few MB). -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/*.png;Assets/tray-*.ico" LogicalName="TrayUsage.Assets.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
